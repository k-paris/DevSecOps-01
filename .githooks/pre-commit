#!/usr/bin/env bash
set -e

PATTERN='(github_pat_[A-Za-z0-9_]+|ghp_[A-Za-z0-9]+|gho_[A-Za-z0-9]+|ghu_[A-Za-z0-9]+|ghs_[A-Za-z0-9]+|ghr_[A-Za-z0-9]+|AKIA[A-Z0-9]{16}|-----BEGIN (RSA |EC |OPENSSH )?PRIVATE KEY-----)'

MATCHES=$(git diff --cached --no-color --unified=0 | grep -E '^\+' | grep -Ev '^\+\+\+' | grep -E "$PATTERN" || true)

if [ -n "$MATCHES" ]; then
    echo "ERROR: Possible secret detected in staged changes:"
    echo
    echo "$MATCHES"
    echo
    echo "Commit blocked."
    exit 1
fi

exit 0
